<?xml version="1.0" encoding="utf-8"?>
<window id="1171">
    <defaultcontrol always="true">10</defaultcontrol>
    <controls>
        <include>GlobalBackground</include>
        <control type="label"><left>100</left><top>100</top><width>1600</width><height>80</height><font>Bold45</font><label>Bingie Experience options</label></control>
        <control type="label"><left>100</left><top>195</top><width>1600</width><height>120</height><font>Reg26</font><label>These options need separately installed, compatible addons.[CR]Leave them off to use the standard Bingie controls.[CR]Changes apply after the skin reloads (Apply below when nothing is playing, or restart Kodi).</label></control>
        <control type="grouplist" id="10">
            <left>100</left><top>330</top><width>1600</width><height>650</height><itemgap>18</itemgap><onback>PreviousMenu</onback>
            <control type="radiobutton" id="11"><width>1600</width><height>65</height><font>Reg30</font><label>Unified Trakt watchlist, browse show and ratings (patched POV)</label><onclick>Skin.ToggleSetting(KM_EnableProviderActions)</onclick><selected>Skin.HasSetting(KM_EnableProviderActions)</selected><enable>Skin.HasSetting(KM_EnableProviderActions) | System.HasAddon(plugin.video.pov)</enable><texturefocus colordiffuse="FF0066FF">colors/color_white.png</texturefocus><texturenofocus colordiffuse="FF20232B">colors/color_white.png</texturenofocus></control>
            <control type="radiobutton" id="12"><width>1600</width><height>65</height><font>Reg30</font><label>Integrated Live TV guide (Kodi navigation helper)</label><onclick>Skin.ToggleSetting(KM_EnableLiveTV)</onclick><selected>Skin.HasSetting(KM_EnableLiveTV)</selected><enable>Skin.HasSetting(KM_EnableLiveTV) | $EXP[KM_HasNavigation]</enable><texturefocus colordiffuse="FF0066FF">colors/color_white.png</texturefocus><texturenofocus colordiffuse="FF20232B">colors/color_white.png</texturenofocus></control>
            <control type="radiobutton" id="13"><width>1600</width><height>65</height><font>Reg30</font><label>Profile controls (compatible navigation helper)</label><onclick>Skin.ToggleSetting(KM_EnableDirectSwitch)</onclick><selected>Skin.HasSetting(KM_EnableDirectSwitch)</selected><enable>Skin.HasSetting(KM_EnableDirectSwitch) | $EXP[KM_HasNavigation]</enable><texturefocus colordiffuse="FF0066FF">colors/color_white.png</texturefocus><texturenofocus colordiffuse="FF20232B">colors/color_white.png</texturenofocus></control>
            <control type="radiobutton" id="15"><width>1600</width><height>65</height><font>Reg30</font><label>Family mode for this profile (curated rows only)</label><onclick>Skin.ToggleSetting(KM_FamilyMode)</onclick><selected>Skin.HasSetting(KM_FamilyMode)</selected><texturefocus colordiffuse="FF0066FF">colors/color_white.png</texturefocus><texturenofocus colordiffuse="FF20232B">colors/color_white.png</texturenofocus></control>
            <control type="radiobutton" id="16"><width>1600</width><height>65</height><font>Reg30</font><label>Use my chosen channel rows</label><onclick>Skin.ToggleSetting(KM_CustomPVRRows)</onclick><selected>Skin.HasSetting(KM_CustomPVRRows)</selected><texturefocus colordiffuse="FF0066FF">colors/color_white.png</texturefocus><texturenofocus colordiffuse="FF20232B">colors/color_white.png</texturenofocus></control>
            <control type="radiobutton" id="18"><width>1600</width><height>65</height><font>Reg30</font><label>Show Recently Watched with custom rows</label><onclick>Skin.ToggleSetting(KM_PVRShowRecent)</onclick><selected>Skin.HasSetting(KM_PVRShowRecent)</selected><texturefocus colordiffuse="FF0066FF">colors/color_white.png</texturefocus><texturenofocus colordiffuse="FF20232B">colors/color_white.png</texturenofocus></control>
            <control type="radiobutton" id="19"><width>1600</width><height>65</height><font>Reg30</font><label>Allow family guide shortcuts (requires a restricted PVR client)</label><onclick>Skin.ToggleSetting(KM_FamilyGuideAllowed)</onclick><selected>Skin.HasSetting(KM_FamilyGuideAllowed)</selected><visible>Skin.HasSetting(KM_FamilyMode)</visible><texturefocus colordiffuse="FF0066FF">colors/color_white.png</texturefocus><texturenofocus colordiffuse="FF20232B">colors/color_white.png</texturenofocus></control>
            <control type="button" id="17"><width>1600</width><height>65</height><font>Reg30</font><label>Choose channel rows (Bingie Companion)</label><onclick>RunScript(script.bingie.companion,configure-pvr)</onclick><enable>System.AddonIsEnabled(script.bingie.companion)</enable><texturefocus colordiffuse="FF0066FF">colors/color_white.png</texturefocus><texturenofocus colordiffuse="FF20232B">colors/color_white.png</texturenofocus></control>
            <control type="button" id="14"><width>1600</width><height>65</height><font>Reg30</font><label>Apply changes now (reloads the skin)</label><onclick>ReloadSkin()</onclick><enable>!Player.HasMedia</enable><disabledcolor>66FFFFFF</disabledcolor><texturefocus colordiffuse="FF0066FF">colors/color_white.png</texturefocus><texturenofocus colordiffuse="FF20232B">colors/color_white.png</texturenofocus></control>
        </control>
    </controls>
</window>
